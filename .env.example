# Resend: verified sender/domain. Never expose these as NEXT_PUBLIC.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Set only to a header your trusted proxy overwrites, e.g. x-vercel-forwarded-for on Vercel.
CONTACT_TRUSTED_IP_HEADER=
# Optional Umami. Loaded only in production on kvndwi.com or www.kvndwi.com.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
